{
  "name": "briefing-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "parse": "node scripts/parse-briefings.js",
    "dev": "npm run parse && vite",
    "build": "npm run verify:salesforce:offline && npm run parse && npm run verify:salesforce:app-data && vite build",
    "preview": "vite preview",
    "verify:salesforce": "node scripts/verify-salesforce-links.js",
    "verify:salesforce:app-data": "node scripts/validate-salesforce-link-cache.js --briefings",
    "verify:salesforce:offline": "node scripts/validate-salesforce-link-cache.js",
    "test:salesforce-links": "node --test scripts/*.test.js"
  },
  "dependencies": {
    "lucide-react": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.0"
  }
}
